# 微信公众号开发者凭证 (必填以支持 push 上传)
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 可选：文章默认作者名
# WECHAT_AUTHOR=your_name

# 可选覆盖项
# 凭证文件路径 (若不使用环境变量，可在私有运行包中放置 credentials 文件)
# WECHAT_CREDENTIALS=/path/to/credentials

# 产物工作目录 (默认保存在 ~/.wechat-article/work/)
# WECHAT_WORK_DIR=./.work

# 站点根目录与域名 (用于补全相对图片、站内链接、封面品牌与字数统计)
# BLOG_ROOT=/path/to/blog
# WECHAT_SITE_URL=https://your-domain.com
# WECHAT_BRAND=your_brand
# WECHAT_SITE_DOMAIN=your-domain.com

# 封面模板选择: c (默认双色书卷宣纸风) / a (杂志风) / b (极客矩阵风)
# WECHAT_COVER_TEMPLATE=c

# 调试与计时
# WECHAT_TIMING=1
